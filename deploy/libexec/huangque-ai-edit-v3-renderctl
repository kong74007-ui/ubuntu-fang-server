#!/usr/bin/env python3
"""Root-owned, fixed-command controller for isolated AI Edit V3 renders."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
from typing import Callable


_INSTANCE_ID = re.compile(r"[a-z0-9](?:[a-z0-9_-]{0,63})\Z")
_MAX_INPUT_BYTES = 8 * 1024 * 1024 * 1024
_MAX_JSON_BYTES = 64 * 1024
_SYSTEMCTL = "/usr/bin/systemctl"
_BUILD_ID = re.compile(r"sha256:[0-9a-f]{64}\Z")
_SHA256 = re.compile(r"[0-9a-f]{64}\Z")


def validate_instance_id(value: str) -> str:
    if not isinstance(value, str) or _INSTANCE_ID.fullmatch(value) is None:
        raise ValueError("render_instance_id_invalid")
    return value


def _default_systemctl(argv: list[str]) -> tuple[int, str, str]:
    completed = subprocess.run(
        argv,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=30,
        text=True,
        env={"LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PATH": "/usr/bin:/bin"},
    )
    return completed.returncode, completed.stdout, completed.stderr


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _plain_file(path: Path) -> bool:
    try:
        metadata = path.lstat()
    except OSError:
        return False
    return stat.S_ISREG(metadata.st_mode) and metadata.st_nlink == 1 and not path.is_symlink()


def _canonical_build_id(lock: dict[str, object]) -> str:
    payload = dict(lock)
    payload.pop("renderer_build_id", None)
    payload.pop("release_archive_sha256", None)
    encoded = json.dumps(payload, ensure_ascii=False, allow_nan=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return f"sha256:{hashlib.sha256(encoded).hexdigest()}"


def _read_json(path: Path) -> dict[str, object]:
    if not _plain_file(path) or path.stat().st_size > _MAX_JSON_BYTES:
        raise ValueError("render_release_lock_invalid")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ValueError("render_release_lock_invalid") from exc
    if not isinstance(value, dict):
        raise ValueError("render_release_lock_invalid")
    return value


def _verify_release_tree(root: Path, lock: dict[str, object]) -> None:
    declarations = lock.get("release_tree_files")
    tree_sha = lock.get("release_tree_sha256")
    if not isinstance(declarations, list) or not isinstance(tree_sha, str) or _SHA256.fullmatch(tree_sha) is None:
        raise ValueError("render_release_tree_invalid")
    digest = hashlib.sha256()
    seen: set[str] = set()
    declared_names: list[str] = []
    for item in declarations:
        if not isinstance(item, dict) or set(item) != {"relative_path", "sha256", "size_bytes"}:
            raise ValueError("render_release_tree_invalid")
        relative = item.get("relative_path")
        expected_hash = item.get("sha256")
        expected_size = item.get("size_bytes")
        if (
            not isinstance(relative, str)
            or not relative
            or relative in seen
            or "\\" in relative
            or Path(relative).is_absolute()
            or ".." in Path(relative).parts
            or not isinstance(expected_hash, str)
            or _SHA256.fullmatch(expected_hash) is None
            or isinstance(expected_size, bool)
            or not isinstance(expected_size, int)
            or expected_size < 0
        ):
            raise ValueError("render_release_tree_invalid")
        seen.add(relative)
        declared_names.append(relative)
        candidate = root.joinpath(*relative.split("/"))
        if not _plain_file(candidate) or candidate.stat().st_size != expected_size or _sha256(candidate) != expected_hash:
            raise ValueError("render_release_tree_mismatch")
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(expected_hash.encode("ascii"))
    if digest.hexdigest() != tree_sha:
        raise ValueError("render_release_tree_mismatch")
    actual_names: list[str] = []
    for directory, names, files in os.walk(root / "src", followlinks=False):
        directory_path = Path(directory)
        for name in names:
            if (directory_path / name).is_symlink():
                raise ValueError("render_release_tree_incomplete")
        actual_names.extend(
            (directory_path / name).relative_to(root).as_posix()
            for name in files
            if name.endswith(".mjs")
        )
    fonts_root = root / "assets" / "fonts"
    try:
        actual_names.extend(path.relative_to(root).as_posix() for path in fonts_root.iterdir())
    except OSError as exc:
        raise ValueError("render_release_tree_incomplete") from exc
    actual_names.extend((root / name).relative_to(root).as_posix() for name in ("package.json", "package-lock.json", "hyperframes.json", "registry-sha256.txt"))
    if sorted(actual_names) != declared_names:
        raise ValueError("render_release_tree_incomplete")


def resolve_render_command(
    *,
    request_path: Path,
    releases_root: Path,
    node_path: Path,
    input_root: Path,
    output_root: Path,
) -> tuple[str, ...]:
    request = _read_json(Path(request_path))
    build_id = request.get("renderer_build_id")
    if not isinstance(build_id, str) or _BUILD_ID.fullmatch(build_id) is None:
        raise ValueError("render_request_build_invalid")
    try:
        root_parent = Path(releases_root).resolve(strict=True)
        release = root_parent / build_id.removeprefix("sha256:")
        metadata = release.lstat()
        if release.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
            raise ValueError("render_release_path_invalid")
        release = release.resolve(strict=True)
        release.relative_to(root_parent)
    except (OSError, ValueError) as exc:
        if isinstance(exc, ValueError) and str(exc).startswith("render_"):
            raise
        raise ValueError("render_release_path_invalid") from exc
    lock = _read_json(release / "renderer-release.lock.json")
    if lock.get("schema_version") not in {1, 2}:
        raise ValueError("render_release_lock_invalid")
    if lock.get("renderer_build_id") != build_id or _canonical_build_id(lock) != build_id:
        raise ValueError("render_release_identity_mismatch")
    if lock.get("schema_version") == 2:
        _verify_release_tree(release, lock)
    else:
        package_hash = lock.get("package_lock_sha256")
        if not isinstance(package_hash, str) or _sha256(release / "package-lock.json") != package_hash:
            raise ValueError("render_release_identity_mismatch")
        for font in lock.get("fonts", []):
            if not isinstance(font, dict) or _sha256(release / str(font.get("relative_path"))) != font.get("sha256"):
                raise ValueError("render_release_identity_mismatch")
    entry = release / "src" / "render.mjs"
    if not _plain_file(entry):
        raise ValueError("render_release_entry_invalid")
    return (
        Path(node_path).as_posix(),
        os.fspath(entry),
        "--request", os.fspath(request_path),
        "--input-root", os.fspath(input_root),
        "--output-root", os.fspath(output_root),
    )


class RenderController:
    def __init__(
        self,
        *,
        spool_root: Path = Path("/var/spool/huangque-ai-edit-v3"),
        state_root: Path = Path("/var/lib/huangque-ai-edit-v3-render"),
        systemctl: Callable[[list[str]], tuple[int, str, str]] = _default_systemctl,
    ) -> None:
        self.spool_root = Path(spool_root)
        self.state_root = Path(state_root)
        self.incoming_root = self.spool_root / "incoming"
        self.results_root = self.spool_root / "results"
        self._systemctl = systemctl

    @staticmethod
    def _unit(instance_id: str) -> str:
        return f"huangque-ai-edit-v3-render@{validate_instance_id(instance_id)}.service"

    def _validate_incoming(self, root: Path) -> None:
        if root.is_symlink() or not root.is_dir():
            raise ValueError("render_input_invalid")
        total = 0
        for path in root.rglob("*"):
            if path.is_symlink():
                raise ValueError("render_input_symlink_forbidden")
            metadata = path.lstat()
            if stat.S_ISDIR(metadata.st_mode):
                continue
            if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
                raise ValueError("render_input_file_invalid")
            total += metadata.st_size
            if total > _MAX_INPUT_BYTES:
                raise ValueError("render_input_too_large")
        if not _plain_file(root / "request.json"):
            raise ValueError("render_request_missing")
        if not _plain_file(root / "assets" / "render-manifest.json"):
            raise ValueError("render_manifest_missing")

    def start(self, instance_id: str) -> dict[str, object]:
        instance = validate_instance_id(instance_id)
        incoming = self.incoming_root / instance
        self._validate_incoming(incoming)
        state = self.state_root / instance
        if state.exists():
            raise ValueError("render_instance_exists")
        state.mkdir(parents=True, mode=0o700)
        staging = state / ".input.staging"
        try:
            # Worker and renderer state are separate systemd bind mounts.  Copy
            # without following links, validate the root-owned copy, then use an
            # atomic rename only inside the renderer-state mount.
            shutil.copytree(incoming, staging, symlinks=True)
            self._validate_incoming(staging)
            os.replace(staging, state / "input")
            (state / "output").mkdir(mode=0o700)
            shutil.rmtree(incoming)
        except Exception:
            shutil.rmtree(state, ignore_errors=True)
            raise
        code, _stdout, _stderr = self._systemctl([_SYSTEMCTL, "start", self._unit(instance)])
        if code != 0:
            raise RuntimeError("render_start_failed")
        return {"state": "running", "result_ready": False, "exit_status": None, "error_code": None}

    def _publish_result(self, instance: str) -> bool:
        output = self.state_root / instance / "output"
        report_path = output / "silent.report.json"
        video_path = output / "silent.mp4"
        snapshots = output / "snapshots"
        if not (_plain_file(report_path) and _plain_file(video_path) and snapshots.is_dir()):
            return False
        try:
            report_bytes = report_path.read_bytes()
            if len(report_bytes) > _MAX_JSON_BYTES:
                return False
            report = json.loads(report_bytes)
            declared = report["output"]
            if report.get("status") != "done" or declared.get("silent") is not True:
                return False
            if declared.get("path") != "silent.mp4" or declared.get("size_bytes") != video_path.stat().st_size:
                return False
            if declared.get("sha256") != _sha256(video_path):
                return False
            entries = report.get("snapshots")
            if not isinstance(entries, list) or not 1 <= len(entries) <= 6:
                return False
            snapshot_names: list[str] = []
            for entry in entries:
                relative = entry.get("path")
                if not isinstance(relative, str) or Path(relative).name != relative:
                    return False
                snapshot = snapshots / relative
                if not _plain_file(snapshot) or entry.get("size_bytes") != snapshot.stat().st_size or entry.get("sha256") != _sha256(snapshot):
                    return False
                snapshot_names.append(relative)
        except (KeyError, OSError, TypeError, ValueError, json.JSONDecodeError):
            return False
        self.results_root.mkdir(parents=True, exist_ok=True)
        destination = self.results_root / instance
        if destination.exists():
            return (
                _plain_file(destination / "silent.mp4")
                and _plain_file(destination / "silent.report.json")
                and all(_plain_file(destination / "snapshots" / name) for name in snapshot_names)
            )
        staging = self.results_root / f".{instance}.ready"
        try:
            import grp
            worker_gid = grp.getgrnam("huangque-ai-edit-v3").gr_gid
        except (ImportError, KeyError):
            worker_gid = -1
        try:
            if staging.exists():
                shutil.rmtree(staging)
            staging.mkdir(mode=0o700)
            shutil.copyfile(video_path, staging / "silent.mp4", follow_symlinks=False)
            shutil.copyfile(report_path, staging / "silent.report.json", follow_symlinks=False)
            snapshot_output = staging / "snapshots"
            snapshot_output.mkdir(mode=0o700)
            for name in snapshot_names:
                shutil.copyfile(snapshots / name, snapshot_output / name, follow_symlinks=False)
            for path in (staging, *staging.rglob("*")):
                if path.is_symlink():
                    raise ValueError("render_result_symlink_forbidden")
                os.chown(path, 0, worker_gid)
                path.chmod(0o750 if path.is_dir() else 0o640)
            os.replace(staging, destination)
        except (OSError, ValueError, shutil.Error):
            shutil.rmtree(staging, ignore_errors=True)
            return False
        return True

    def query(self, instance_id: str) -> dict[str, object]:
        instance = validate_instance_id(instance_id)
        argv = [
            _SYSTEMCTL, "show", self._unit(instance),
            "--property=ActiveState", "--property=SubState", "--property=Result",
            "--property=ExecMainStatus",
        ]
        code, stdout, _stderr = self._systemctl(argv)
        if code != 0 or len(stdout.encode("utf-8", errors="replace")) > _MAX_JSON_BYTES:
            return {"state": "failed", "result_ready": False, "exit_status": None, "error_code": "render_status_failed"}
        properties: dict[str, str] = {}
        for line in stdout.splitlines():
            key, separator, value = line.partition("=")
            if separator and key in {"ActiveState", "SubState", "Result", "ExecMainStatus"}:
                properties[key] = value
        if set(properties) != {"ActiveState", "SubState", "Result", "ExecMainStatus"}:
            return {"state": "failed", "result_ready": False, "exit_status": None, "error_code": "render_status_failed"}
        active = properties["ActiveState"]
        sub = properties["SubState"]
        result = properties["Result"]
        raw_status = properties["ExecMainStatus"]
        try:
            exit_status = int(raw_status)
        except ValueError:
            exit_status = None
        if active in {"activating", "reloading"}:
            state = "queued"
        elif active == "active" or sub in {"start", "running"}:
            state = "running"
        elif active == "inactive" and result in {"success", ""} and exit_status in {0, None}:
            state = "succeeded" if self._publish_result(instance) else "failed"
        elif active == "failed" or result not in {"success", ""} or (exit_status not in {0, None}):
            state = "failed"
        else:
            state = "stopped"
        return {
            "state": state,
            "result_ready": state == "succeeded",
            "exit_status": exit_status,
            "error_code": None if state in {"queued", "running", "succeeded"} else "render_process_failed",
        }

    def stop(self, instance_id: str) -> dict[str, object]:
        instance = validate_instance_id(instance_id)
        code, _stdout, _stderr = self._systemctl([_SYSTEMCTL, "stop", self._unit(instance)])
        if code != 0:
            raise RuntimeError("render_stop_failed")
        return {"state": "stopped", "result_ready": False, "exit_status": None, "error_code": None}


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[1] == "run":
        try:
            validate_instance_id(argv[2])
            command = resolve_render_command(
                request_path=Path("/work/input/request.json"),
                releases_root=Path("/renderer-releases"),
                node_path=Path("/usr/bin/node"),
                input_root=Path("/work/input/assets"),
                output_root=Path("/work/output"),
            )
            environment = {
                "HOME": "/work/output/home",
                "LANG": "C.UTF-8",
                "LC_ALL": "C.UTF-8",
                "TZ": "UTC",
                "PUPPETEER_EXECUTABLE_PATH": os.environ.get("PUPPETEER_EXECUTABLE_PATH", "/usr/bin/google-chrome-stable"),
            }
            os.execve(command[0], list(command), environment)
        except Exception as exc:
            error = str(exc) if str(exc).startswith("render_") else "render_control_failed"
            print(json.dumps({"state": "failed", "result_ready": False, "exit_status": None, "error_code": error}, separators=(",", ":")))
            return 1
    if len(argv) != 3 or argv[1] not in {"start", "query", "stop"}:
        result = {"state": "failed", "result_ready": False, "exit_status": None, "error_code": "render_command_invalid"}
        print(json.dumps(result, separators=(",", ":")))
        return 2
    try:
        controller = RenderController()
        result = getattr(controller, argv[1])(argv[2])
        encoded = json.dumps(result, separators=(",", ":"))
        if len(encoded.encode("utf-8")) > _MAX_JSON_BYTES:
            raise RuntimeError("render_response_too_large")
        print(encoded)
        return 0
    except Exception as exc:
        error = str(exc) if str(exc).startswith("render_") else "render_control_failed"
        print(json.dumps({"state": "failed", "result_ready": False, "exit_status": None, "error_code": error}, separators=(",", ":")))
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
