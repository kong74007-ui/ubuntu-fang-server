#!/usr/bin/env bash
set -euo pipefail

: "${PIXELLE_NOVIX_SSH_TARGET:?missing PIXELLE_NOVIX_SSH_TARGET}"
: "${PIXELLE_NOVIX_SSH_KEY:?missing PIXELLE_NOVIX_SSH_KEY}"
: "${PIXELLE_NOVIX_SSH_KNOWN_HOSTS:?missing PIXELLE_NOVIX_SSH_KNOWN_HOSTS}"

LOCAL_PORT="${PIXELLE_NOVIX_LOCAL_PORT:-10811}"
REMOTE_HOST="${PIXELLE_NOVIX_REMOTE_HOST:-127.0.0.1}"
REMOTE_PORT="${PIXELLE_NOVIX_REMOTE_PORT:-10810}"

if [[ ! "${PIXELLE_NOVIX_SSH_TARGET}" =~ ^[a-z_][a-z0-9_-]*@[A-Za-z0-9.-]+$ ]]; then
  echo "invalid PIXELLE_NOVIX_SSH_TARGET" >&2
  exit 2
fi
if [[ ! "${LOCAL_PORT}" =~ ^[0-9]+$ ]] || (( LOCAL_PORT < 1024 || LOCAL_PORT > 65535 )); then
  echo "invalid PIXELLE_NOVIX_LOCAL_PORT" >&2
  exit 2
fi
if [[ "${REMOTE_HOST}" != "127.0.0.1" ]]; then
  echo "PIXELLE_NOVIX_REMOTE_HOST must be 127.0.0.1" >&2
  exit 2
fi
if [[ ! "${REMOTE_PORT}" =~ ^[0-9]+$ ]] || (( REMOTE_PORT < 1024 || REMOTE_PORT > 65535 )); then
  echo "invalid PIXELLE_NOVIX_REMOTE_PORT" >&2
  exit 2
fi
if [[ "${LOCAL_PORT}" == "${REMOTE_PORT}" ]]; then
  echo "local and remote Novix ports must differ" >&2
  exit 2
fi
for path in "${PIXELLE_NOVIX_SSH_KEY}" "${PIXELLE_NOVIX_SSH_KNOWN_HOSTS}"; do
  if [[ ! -f "${path}" || -L "${path}" || ! -r "${path}" ]]; then
    echo "Novix tunnel credential file is missing, unreadable, or a symlink" >&2
    exit 2
  fi
done
KEY_MODE="$(stat -c '%a' "${PIXELLE_NOVIX_SSH_KEY}")"
KNOWN_HOSTS_MODE="$(stat -c '%a' "${PIXELLE_NOVIX_SSH_KNOWN_HOSTS}")"
if [[ "${KEY_MODE}" != "600" && "${KEY_MODE}" != "640" ]]; then
  echo "Novix tunnel private key mode must be 600 or 640" >&2
  exit 2
fi
if [[ "${KNOWN_HOSTS_MODE}" != "600" && "${KNOWN_HOSTS_MODE}" != "640" && "${KNOWN_HOSTS_MODE}" != "644" ]]; then
  echo "Novix tunnel known_hosts mode must be 600, 640, or 644" >&2
  exit 2
fi

exec /usr/bin/ssh -F /dev/null -NT \
  -i "${PIXELLE_NOVIX_SSH_KEY}" \
  -o BatchMode=yes \
  -o IdentitiesOnly=yes \
  -o ExitOnForwardFailure=yes \
  -o PermitLocalCommand=no \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=yes \
  -o "UserKnownHostsFile=${PIXELLE_NOVIX_SSH_KNOWN_HOSTS}" \
  -L "127.0.0.1:${LOCAL_PORT}:${REMOTE_HOST}:${REMOTE_PORT}" \
  "${PIXELLE_NOVIX_SSH_TARGET}"
