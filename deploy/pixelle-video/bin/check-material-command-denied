#!/usr/bin/env bash
set -euo pipefail

: "${PIXELLE_MATERIAL_SSH_TARGET:?missing PIXELLE_MATERIAL_SSH_TARGET}"
: "${PIXELLE_MATERIAL_SSH_KEY:?missing PIXELLE_MATERIAL_SSH_KEY}"
: "${PIXELLE_MATERIAL_SSH_KNOWN_HOSTS:?missing PIXELLE_MATERIAL_SSH_KNOWN_HOSTS}"
if [[ ! "${PIXELLE_MATERIAL_SSH_TARGET}" =~ ^material_tunnel@[A-Za-z0-9.-]+$ ]]; then
  echo "invalid PIXELLE_MATERIAL_SSH_TARGET" >&2
  exit 2
fi

set +e
OUTPUT="$(/usr/bin/ssh -F /dev/null -T \
  -i "${PIXELLE_MATERIAL_SSH_KEY}" \
  -o BatchMode=yes -o IdentitiesOnly=yes -o PermitLocalCommand=no \
  -o ConnectTimeout=5 \
  -o StrictHostKeyChecking=yes \
  -o "UserKnownHostsFile=${PIXELLE_MATERIAL_SSH_KNOWN_HOSTS}" \
  "${PIXELLE_MATERIAL_SSH_TARGET}" id -un 2>/dev/null)"
STATUS=$?
set -e
if [[ "${STATUS}" -ne 1 || -n "${OUTPUT}" ]]; then
  echo "material tunnel command denial is missing or unverifiable (status ${STATUS})" >&2
  exit 1
fi
echo "material tunnel remote-command denial verified"
