#!/usr/bin/env bash
set -euo pipefail

TUNNEL_USER="material_tunnel"
EXPECTED_HOME="/var/lib/huangque-material-tunnel"
EXPECTED_SHELL="/usr/bin/false"
: "${MATERIAL_TUNNEL_SOURCE_ADDRESS:?missing MATERIAL_TUNNEL_SOURCE_ADDRESS}"
if [[ ! "${MATERIAL_TUNNEL_SOURCE_ADDRESS}" =~ ^[0-9A-Fa-f:.]+$ ]]; then
  echo "invalid MATERIAL_TUNNEL_SOURCE_ADDRESS" >&2
  exit 2
fi
if [[ "$(id -u)" -ne 0 ]]; then
  echo "run as root" >&2
  exit 2
fi
entry="$(getent passwd "${TUNNEL_USER}" || true)"
if [[ -z "${entry}" ]]; then
  echo "missing ${TUNNEL_USER} account" >&2
  exit 1
fi
IFS=: read -r _ _ _ _ _ actual_home actual_shell <<<"${entry}"
if [[ "${actual_home}" != "${EXPECTED_HOME}" || "${actual_shell}" != "${EXPECTED_SHELL}" ]]; then
  echo "${TUNNEL_USER} account has an unexpected home or shell" >&2
  exit 1
fi
if [[ "$(passwd -S "${TUNNEL_USER}" | awk '{print $2}')" != "P" ]]; then
  echo "${TUNNEL_USER} account must be non-locked state P" >&2
  exit 1
fi
effective="$(/usr/sbin/sshd -T -C user=${TUNNEL_USER},host=material-library,addr=${MATERIAL_TUNNEL_SOURCE_ADDRESS})"
for expected in \
    "authenticationmethods publickey" \
    "passwordauthentication no" \
    "kbdinteractiveauthentication no" \
    "allowtcpforwarding local" \
    "allowstreamlocalforwarding no" \
    "permitopen 127.0.0.1:8110" \
    "permitlisten none" \
    "gatewayports no" \
    "forcecommand /usr/bin/false" \
    "permittty no" \
    "permittunnel no" \
    "permituserrc no" \
    "allowagentforwarding no" \
    "x11forwarding no"; do
  grep -Fxq "${expected}" <<<"${effective}" || {
    echo "missing effective sshd restriction: ${expected}" >&2
    exit 1
  }
done
echo "material-library forwarding-only account verified"
