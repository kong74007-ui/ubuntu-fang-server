diff --git a/pixelle_video/services/frame_processor.py b/pixelle_video/services/frame_processor.py
index 5931412..29bbc45 100644
--- a/pixelle_video/services/frame_processor.py
+++ b/pixelle_video/services/frame_processor.py
@@ -35,0 +36 @@ from pixelle_video.services.caption_cues import (
+    build_proportional_caption_timeline,
@@ -473,0 +475,35 @@ class FrameProcessor:
+        cue_has_audio = [bool(cue.audio_path) for cue in frame.caption_cues]
+        if any(cue_has_audio) and not all(cue_has_audio):
+            raise ValueError("caption cue audio must be either complete or display-only")
+        if not any(cue_has_audio):
+            if not frame.audio_path:
+                frame.audio_path = await self._generate_audio_text(
+                    frame.narration,
+                    str(base_audio_path),
+                    frame.index,
+                    config,
+                )
+            total_duration = await self._get_audio_duration_strict(frame.audio_path)
+            timeline = build_proportional_caption_timeline(
+                [{"text": cue.text} for cue in frame.caption_cues],
+                total_duration,
+            )
+            for cue_index, (cue, timing) in enumerate(zip(frame.caption_cues, timeline)):
+                cue.duration = timing["duration"]
+                cue.start_time = timing["start_time"]
+                cue.end_time = timing["end_time"]
+                if len(frame.caption_cues) == 1:
+                    cue.audio_path = frame.audio_path
+                else:
+                    cue_path = base_audio_path.with_name(
+                        f"{base_audio_path.stem}_cue_{cue_index + 1:02d}.wav"
+                    )
+                    cue.audio_path = self._extract_audio_clip(
+                        frame.audio_path,
+                        cue.start_time,
+                        cue.duration,
+                        str(cue_path),
+                    )
+            frame.duration = total_duration
+            return
+
@@ -509,0 +546,23 @@ class FrameProcessor:
+    @staticmethod
+    def _extract_audio_clip(
+        audio_path: str,
+        start_time: float,
+        duration: float,
+        output_path: str,
+    ) -> str:
+        """Slice continuous speech after TTS so caption changes do not add pauses."""
+        import ffmpeg
+
+        try:
+            (
+                ffmpeg
+                .input(audio_path, ss=max(0.0, float(start_time)), t=float(duration))
+                .output(output_path, acodec="pcm_s16le", ac=2, ar=44100)
+                .overwrite_output()
+                .run(capture_stdout=True, capture_stderr=True)
+            )
+        except ffmpeg.Error as exc:
+            details = exc.stderr.decode("utf-8", errors="replace") if exc.stderr else str(exc)
+            raise RuntimeError(f"Failed to slice continuous narration audio: {details}") from exc
+        return output_path
+
