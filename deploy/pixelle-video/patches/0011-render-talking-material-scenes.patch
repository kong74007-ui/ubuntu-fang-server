+    @staticmethod
+    def _talking_scene_selection(
+        frame: StoryboardFrame,
+        config: StoryboardConfig,
+    ) -> dict | None:
+        talking_material = config.talking_material or {}
+        if not talking_material.get("enabled"):
+            return None
+        for selection in talking_material.get("scenes") or []:
+            if selection.get("scene_id") == frame.scene_id and selection.get("enabled"):
+                return selection
+        return None
+
+    @staticmethod
+    def _talking_ratio(config: StoryboardConfig) -> str:
+        width = int(config.media_width or 0)
+        height = int(config.media_height or 0)
+        if width <= 0 or height <= 0:
+            raise ValueError("talking material requires positive media dimensions")
+        divisor = math.gcd(width, height)
+        exact = f"{width // divisor}:{height // divisor}"
+        if exact in {"9:16", "16:9", "1:1"}:
+            return exact
+        return "9:16" if height > width else "16:9"
+
+    @staticmethod
+    def _raise_if_talking_cancelled() -> None:
