+        frame.talking_cue_video_paths.clear()
+        if frame.talking_single_override:
+            frame.video_path = frame.talking_original_video_path
+            frame.media_type = frame.talking_original_media_type
+            frame.talking_original_video_path = None
+            frame.talking_original_media_type = None
+            frame.talking_single_override = False
+
+    @staticmethod
