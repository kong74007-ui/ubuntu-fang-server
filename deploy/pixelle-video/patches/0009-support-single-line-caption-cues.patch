+    async def _get_audio_duration_strict(self, audio_path: str) -> float:
+        """Probe a positive real duration; caption timing must never be estimated."""
+        import ffmpeg
+
+        try:
+            probe = ffmpeg.probe(audio_path)
+            duration = float(probe["format"]["duration"])
+        except Exception as exc:
+            raise RuntimeError(f"Failed to probe caption audio duration: {audio_path}") from exc
+        if duration <= 0:
+            raise RuntimeError(f"Caption audio has non-positive duration: {audio_path}")
+        return duration
