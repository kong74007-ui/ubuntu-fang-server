+    def concat_audios(self, audios: List[str], output: str) -> str:
+        """Concatenate narration cue audio into one frame-level track."""
+        self._ensure_ffmpeg()
+        if not audios:
+            raise ValueError("Audios list cannot be empty")
+        if len(audios) == 1:
+            shutil.copy(audios[0], output)
+            return output
+        try:
+            streams = [ffmpeg.input(path).audio for path in audios]
+            joined = ffmpeg.concat(*streams, v=0, a=1)
+            (
+                ffmpeg.output(joined, output, acodec="libmp3lame", audio_bitrate="192k")
+                .overwrite_output()
+                .run(capture_stdout=True, capture_stderr=True)
+            )
+            return output
+        except ffmpeg.Error as exc:
+            error_msg = exc.stderr.decode() if exc.stderr else str(exc)
+            raise RuntimeError(f"Failed to concatenate audio: {error_msg}") from exc
+
+    def extract_video_clip(
+        self,
+        video: str,
+        start_time: float,
+        duration: float,
+        output: str,
+    ) -> str:
+        """Extract a re-encoded video slice at an exact cue offset."""
+        self._ensure_ffmpeg()
+        if start_time < 0 or duration <= 0:
+            raise ValueError("Video clip timing must be positive")
+        try:
+            source = ffmpeg.input(video, ss=start_time, t=duration)
+            (
+                ffmpeg.output(
+                    source.video,
+                    output,
+                    vcodec="libx264",
+                    pix_fmt="yuv420p",
+                    preset="medium",
+                    crf=23,
+                    an=None,
+                )
+                .overwrite_output()
+                .run(capture_stdout=True, capture_stderr=True)
+            )
+            return output
+        except ffmpeg.Error as exc:
+            error_msg = exc.stderr.decode() if exc.stderr else str(exc)
+            raise RuntimeError(f"Failed to extract video clip: {error_msg}") from exc
     
