+class NarrationSegment(BaseModel):
+    text: str = Field(..., min_length=1, max_length=1000)
+    audio_asset_id: Optional[str] = Field(None, pattern=r"^audio_[0-9a-f]{32}$")
+    cues: Optional[list[NarrationCue]] = Field(None, min_length=1, max_length=20)
+
+    @model_validator(mode="after")
+    def validate_audio_shape(self):
+        if bool(self.audio_asset_id) == bool(self.cues):
+            raise ValueError("exactly one of audio_asset_id or cues is required")
+        for cue in self.cues or []:
+            validate_caption_cue_text(cue.text)
+        if self.cues and "".join(cue.text for cue in self.cues) != self.text:
+            raise ValueError("narration cue text must preserve the scene text")
+        return self
+
