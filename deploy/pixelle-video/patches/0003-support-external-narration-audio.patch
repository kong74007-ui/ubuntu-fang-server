--- a/api/schemas/video.py
+++ b/api/schemas/video.py
@@ -18 +18,6 @@ from typing import Optional, Literal, Dict, Any
-from pydantic import BaseModel, Field
+from pydantic import BaseModel, Field, model_validator
+
+
+class NarrationSegment(BaseModel):
+    text: str = Field(..., min_length=1, max_length=1000)
+    audio_asset_id: str = Field(..., pattern=r"^audio_[0-9a-f]{32}$")
@@ -51,0 +57,7 @@ class VideoGenerateRequest(BaseModel):
+    tts_voice: Optional[str] = Field(None, description="TTS voice name")
+    narration_segments: Optional[list[NarrationSegment]] = Field(
+        None,
+        min_length=1,
+        max_length=20,
+        description="Pre-synthesized narration segments uploaded through /api/audio-assets",
+    )
@@ -85,0 +98,10 @@ class VideoGenerateRequest(BaseModel):
+    @model_validator(mode="after")
+    def validate_external_narration(self):
+        if not self.narration_segments:
+            return self
+        if self.mode != "fixed":
+            raise ValueError("narration_segments requires mode='fixed'")
+        if any((self.voice_id, self.tts_workflow, self.ref_audio, self.tts_voice)):
+            raise ValueError("narration_segments cannot be combined with TTS or reference-audio fields")
+        return self
+
