--- a/api/routers/video.py
+++ b/api/routers/video.py
@@ -20,0 +21 @@ import uuid
+from api import avatar_assets
@@ -34,0 +36,27 @@ router = APIRouter(prefix="/video", tags=["Video Generation"])
+def _talking_material_asset_ids(request_body: VideoGenerateRequest) -> list[str]:
+    talking_material = request_body.talking_material
+    if talking_material is None:
+        return []
+    asset_ids = []
+    if talking_material.default_avatar_asset_id:
+        asset_ids.append(talking_material.default_avatar_asset_id)
+    asset_ids.extend(
+        scene.avatar_asset_id
+        for scene in talking_material.scenes
+        if scene.avatar_asset_id
+    )
+    return list(dict.fromkeys(asset_ids))
+
+
+def _lease_talking_material_assets(request_body: VideoGenerateRequest, task_id: str) -> list[str]:
+    asset_ids = _talking_material_asset_ids(request_body)
+    if not asset_ids:
+        return []
+    try:
+        avatar_assets.lease_avatar_assets(asset_ids, task_id)
+    except FileNotFoundError as exc:
+        raise HTTPException(status_code=404, detail="avatar asset not found") from exc
+    except avatar_assets.AvatarLeaseError as exc:
+        raise HTTPException(status_code=409, detail="avatar asset is already in use") from exc
+    except ValueError as exc:
+        raise HTTPException(status_code=400, detail=str(exc)) from exc
+    return asset_ids
