index 0000000..ca1d9e4
--- /dev/null
+++ b/scripts/test_private_domain_layouts.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""Regression checks for generation-server private-domain layouts."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import tempfile
+
+import render_video
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main() -> None:
+    catalog = json.loads((ROOT / "assets/templates/catalog.json").read_text(encoding="utf-8"))
+    templates = {item["id"]: item for item in catalog["templates"]}
+    expected = {
+        "full-overlay-bold": (0, 0, 1080, 1920),
+        "poster-split": (0, 600, 1080, 820),
+    }
+    for template_id, geometry in expected.items():
+        project, resolved = render_video.resolve_template({"layout": {"template_id": template_id}})
+        assert resolved == template_id
+        warnings: list[str] = []
+        layout = render_video.resolve_layout(project, 1080, 1920, warnings)
+        assert layout and not warnings
+        assert layout["variant"] == template_id
+        assert (
+            layout["media_x"], layout["media_y"],
+            layout["media_width"], layout["media_height"],
+        ) == geometry
+        scene = {
+            "top_text": "在深圳有5000人\n高净值女性圈",
+            "bottom_text": "评论区扣“666”邀请您参加",
+            "top_highlights": [{"text": "5000人", "color": "#FFD400"}],
+            "bottom_highlights": [{"text": "666", "color": "#FFD400"}],
+        }
