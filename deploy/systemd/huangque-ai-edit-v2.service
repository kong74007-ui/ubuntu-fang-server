[Unit]
Description=Huangque AI Edit V2 isolated worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/content-api
EnvironmentFile=-/home/ubuntu/auth-service/auth.env
EnvironmentFile=/etc/huangque/ai-edit-v2.env
ExecStart=/usr/bin/python3 /home/ubuntu/content-api/ai_edit_v2_worker.py
Restart=always
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
