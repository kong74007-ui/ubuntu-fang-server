[Unit]
Description=Huangque AI Edit V3 worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=huangque-ai-edit-v3
Group=huangque-ai-edit-v3
SupplementaryGroups=ubuntu
EnvironmentFile=-/home/ubuntu/content-api/content.env
EnvironmentFile=-/home/ubuntu/auth-service/auth.env
EnvironmentFile=/etc/huangque/ai-edit-v3.env
Environment=CONTENT_ASSET_DB=/var/lib/huangque-ai-edit-v3/shared-assets.db
Environment=AI_EDIT_V2_ASSET_DB=/var/lib/huangque-ai-edit-v3/shared-assets.db
UMask=0007
RuntimeDirectory=huangque-ai-edit-v3
RuntimeDirectoryMode=0700
WorkingDirectory=/home/ubuntu/content-api
ExecStart=/home/ubuntu/content-api/venv/bin/python /home/ubuntu/content-api/ai_edit_v3_worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
BindReadOnlyPaths=/home/ubuntu/content-api/ai_edit_v2.db:/run/huangque-ai-edit-v3/ai_edit_v2.db
ReadWritePaths=/var/lib/huangque-ai-edit-v3-private /var/lib/huangque-ai-edit-v3 /var/spool/huangque-ai-edit-v3

[Install]
WantedBy=multi-user.target
