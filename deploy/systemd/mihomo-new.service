[Unit]
Description=Huangque Mihomo subscription proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/bin/mihomo -d /home/ubuntu/.config/mihomo-new
ExecStartPost=/usr/local/libexec/huangque/check-mihomo-openai-proxy
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.config/mihomo-new

[Install]
WantedBy=multi-user.target
