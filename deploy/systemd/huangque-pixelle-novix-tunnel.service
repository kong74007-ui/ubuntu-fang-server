[Unit]
Description=Restricted tunnel from Pixelle to production Novix egress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
EnvironmentFile=/etc/huangque/pixelle-novix-tunnel.env
ExecStart=/usr/local/libexec/huangque/run-pixelle-novix-tunnel
ExecStartPost=/usr/local/libexec/huangque/check-pixelle-novix-openai
ExecStartPost=/usr/local/libexec/huangque/check-pixelle-novix-command-denied
ExecStartPost=/usr/local/libexec/huangque/check-pixelle-novix-remote-forward-denied
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
