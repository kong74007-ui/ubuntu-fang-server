{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authorization_ref", "cases"],
  "properties": {
    "version": {"const": "3.1"},
    "authorization_ref": {"type": "string", "minLength": 3, "maxLength": 128},
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "sha256", "media_type", "duration_ms", "owner_alias", "authorization_ref"],
      "properties": {
        "alias": {"type": "string", "minLength": 3, "maxLength": 128},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"enum": ["video/mp4", "audio/mpeg", "audio/wav", "text/plain", "image/jpeg", "image/png"]},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
        "intrinsic_ratio": {"enum": ["16:9", "9:16", null]},
        "semantic_status": {"enum": ["matched", "partial", null]},
        "contains_person": {"type": "boolean"},
        "person_role": {"enum": ["speaker", "reference_person", "unrelated_person", "none", null]},
        "owner_alias": {"type": "string", "minLength": 3, "maxLength": 128},
        "authorization_ref": {"type": "string", "minLength": 3, "maxLength": 128}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "input_type", "creation_mode", "ratio", "template_id", "style_prompt", "content_category", "risk_tags", "authorization_ref", "source", "materials"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^case_[0-9]{2}$"},
        "input_type": {"enum": ["platform_talking_head", "uploaded_video", "existing_audio", "uploaded_audio", "script_to_audio_video"]},
        "creation_mode": {"enum": ["ai_auto", "style_prompt", "template_reference"]},
        "ratio": {"enum": ["16:9", "9:16"]},
        "template_id": {"type": ["string", "null"]},
        "style_prompt": {"type": ["string", "null"], "maxLength": 500},
        "talking_head_kind": {"enum": ["platform_avatar", "uploaded_real_person", null]},
        "subject_alias": {"type": ["string", "null"], "minLength": 3, "maxLength": 128},
        "background_alias": {"type": ["string", "null"], "minLength": 3, "maxLength": 128},
        "content_category": {"enum": ["commercial", "knowledge", "product", "franchise", "store"]},
        "risk_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 64}},
        "authorization_ref": {"type": "string", "minLength": 3, "maxLength": 128},
        "source": {"$ref": "#/$defs/binding"},
        "materials": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/binding"}}
      }
    }
  }
}
