    "/api/gen/audio/redeem-slot": {
      "post": {
        "tags": [
          "音频模块"
        ],
        "summary": "兑换个人音色槽位",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "example": "HQVOICE-XXXX-XXXX"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "兑换成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "slot": {
                      "$ref": "#/components/schemas/AudioVoiceSlot"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "兑换码无效/已使用/无可用槽位"
          },
          "401": {
            "description": "未登录"
          }
        }
      }
    },
    "/api/gen/audio/clone-vip": {
      "post": {
        "tags": [
          "音频模块"
        ],
        "summary": "VIP 声音复刻上传（异步后台处理）",
        "description": "后端先标记槽位 training 并清空旧试听音频，再后台调用豆包上传接口。必须继续轮询 clone-status，等豆包 status=2 后生成测试音频，最终 ready。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloneVipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已进入 training",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "voice": {
                      "$ref": "#/components/schemas/AudioVoiceSlot"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "槽位不存在/次数用完/上传失败"
          },
          "401": {
            "description": "未登录"
          }
        }
      }
    },
    "/api/gen/audio/clone-status": {
      "get": {
        "tags": [
          "音频模块"
        ],
        "summary": "查询 VIP 复刻状态并生成试听音频",
        "description": "若豆包返回旧 create_time/demo_audio，会继续等待本次新结果；本次训练完成后调用豆包 TTS 生成测试音频，并更新 audio_voices.preview_url。",
        "parameters": [
          {
            "name": "slot_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "S_dMKA8OR62"
          }
        ],
        "responses": {
          "200": {
            "description": "当前状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "result": {
                      "$ref": "#/components/schemas/CloneStatusResult"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "查询失败"
          },
          "401": {
            "description": "未登录"
          }
        }
      }
    }
  }
}
