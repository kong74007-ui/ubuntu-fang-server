{
  "name": "huangque-ai-edit-v3-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22 <23"},
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "release:lock": "node src/release-manifest.mjs --write --release-root .",
    "release:lock:check": "node src/release-manifest.mjs --check --release-root .",
    "visual-capabilities:write": "node src/write-visual-capabilities.mjs",
    "visual-capabilities:check": "node src/write-visual-capabilities.mjs --check",
    "registry:hash": "node src/write-visual-capabilities.mjs && node src/write-registry-hash.mjs",
    "registry:hash:check": "node src/write-visual-capabilities.mjs --check && node src/write-registry-hash.mjs --check",
    "manifest-schema:write": "node scripts/write-manifest-schema-digests.mjs",
    "manifest-schema:check": "node scripts/write-manifest-schema-digests.mjs --check",
    "hf:check": "hyperframes check",
    "hf:keyframes": "hyperframes keyframes",
    "hf:snapshot": "hyperframes snapshot",
    "render:fixtures": "node test/render-fixtures.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "hyperframes": "0.7.84"
  }
}
